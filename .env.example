# GEMINI_API_KEY: Generous Free Tier from Google AI Studio (Preferred NLP engine)
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# NLP Configuration: "gemini" (preferred free tier), "local" (100% free/offline rules), or "openai" (legacy adapter)
NLP_PROVIDER="gemini"
OPENAI_API_KEY=""

# Optimization Tuning
MAX_OPTIMIZATION_ITERATIONS=3
OPTIMIZATION_TARGET_SCORE=90

# Mail Infrastructure (Self-Hosted Primary vs Optional Cloud)
# "kumomta" (default, self-hosted, zero per-email fees) or "ses" (optional AWS cloud MTA)
MAIL_PROVIDER="kumomta"
KUMOMTA_API_ENDPOINT=""
KUMOMTA_API_KEY=""

# AWS SES Configuration (Optional Cloud Fallback)
AWS_SES_REGION=""
AWS_SES_ACCESS_KEY_ID=""
AWS_SES_SECRET_ACCESS_KEY=""

# External Deliverability Testing APIs (Optional - defaults to internal analysis engine)
# Set to true only if you have active paid subscriptions/webhooks
ENABLE_MAILTESTER=false
MAILTESTER_API_KEY=""

ENABLE_GLOCKAPPS=false
GLOCKAPPS_API_KEY=""

